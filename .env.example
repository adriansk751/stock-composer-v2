# SmartBill API Configuration
SMARTBILL_EMAIL=your-email@example.com
SMARTBILL_TOKEN=your-smartbill-api-token
SMARTBILL_CIF=your-company-cif

# easySales API Configuration
EASYSALES_TOKEN=your-easysales-bearer-token

# Google Sheets API Configuration
# Option 1: Path to service account JSON file
GOOGLE_CREDENTIALS_PATH=credentials.json

# Option 2: Service account JSON as string (alternative to file path)
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# Google Sheets Settings (Optional - can be configured in UI)
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_WORKSHEET_NAME=Sheet1
